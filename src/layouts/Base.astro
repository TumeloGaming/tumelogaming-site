---
// ── src/layouts/Base.astro ────────────────────────────────────────
// The root layout wrapping every page on the site.
// Responsibilities:
//   1. Inject CSS custom properties (colours + fonts) from Sanity CMS
//   2. Render full <head> with OG / Twitter Card meta tags
//   3. Load the correct Google Fonts based on CMS font settings
//   4. Set the favicon from Sanity's media manager
//   5. Provide the noise grain overlay and canvas slot

import { getSiteSettings, imageUrl } from '../lib/sanity';
import { buildCssVars, buildFontUrl, buildOgMeta } from '../lib/theme';

interface Props {
  // Per-page overrides — all optional; fall back to global siteSettings
  pageTitle?:  string;
  pageDesc?:   string;
  pageImage?:  any;
  canonical?:  string;
}

const { pageTitle, pageDesc, pageImage, canonical } = Astro.props;

// Fetch global settings — cached by Astro's build pipeline
const settings = await getSiteSettings();

// Build CSS variable block from CMS colours + fonts
const cssVars  = buildCssVars(settings.colors, settings.fonts);

// Build Google Fonts URL from CMS font settings
const fontUrl  = buildFontUrl(settings.fonts);

// Resolve OG metadata (page overrides > global fallback)
const siteUrl  = import.meta.env.PUBLIC_SITE_URL ?? '';
const pageUrl  = canonical ?? (siteUrl + Astro.url.pathname);
const { title: ogTitle, desc: ogDesc, imgUrl: ogImgUrl } = buildOgMeta({
  settings, pageTitle, pageDesc, pageImage, pageUrl,
  imageUrlFn: imageUrl,
});

// Favicon URL — served from Sanity CDN, auto-optimised
const faviconUrl = settings.favicon
  ? imageUrl(settings.favicon, 512, 512)
  : '/favicon.png'; // fallback to /public/favicon.png
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- ── Page title ─────────────────────────────────────── -->
  <title>{ogTitle}</title>

  <!-- ── Canonical URL ──────────────────────────────────── -->
  <link rel="canonical" href={pageUrl} />

  <!-- ── Favicon (from Sanity media manager) ────────────── -->
  <link rel="icon"             type="image/png" sizes="512x512" href={faviconUrl} />
  <link rel="apple-touch-icon" type="image/png" sizes="512x512" href={faviconUrl} />

  <!-- ── Open Graph (Discord / Slack / iMessage embeds) ── -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={pageUrl} />
  <meta property="og:title"       content={ogTitle} />
  <meta property="og:description" content={ogDesc} />
  {ogImgUrl && <meta property="og:image" content={ogImgUrl} />}
  {ogImgUrl && <meta property="og:image:width"  content="1200" />}
  {ogImgUrl && <meta property="og:image:height" content="630"  />}

  <!-- ── Twitter / X Card ───────────────────────────────── -->
  <meta name="twitter:card"        content={ogImgUrl ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title"       content={ogTitle} />
  <meta name="twitter:description" content={ogDesc} />
  {ogImgUrl && <meta name="twitter:image" content={ogImgUrl} />}

  <!-- ── SEO description ────────────────────────────────── -->
  <meta name="description" content={ogDesc} />

  <!-- ── Google Fonts (font family names set in CMS) ────── -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontUrl} rel="stylesheet" />

  <!-- ── CSS custom properties injected from Sanity CMS ─── -->
  <!-- Changing any colour or font in Site Settings and     -->
  <!-- publishing will regenerate these variables globally. -->
  <style set:html={`:root { ${cssVars} }`}></style>

  <!-- ── Global base styles ─────────────────────────────── -->
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      background:   var(--bg);
      color:        var(--text);
      font-family:  var(--font-body);
      overflow-x:   hidden;
    }

    /* ── Noise grain overlay ─────────────────────────── */
    body::before {
      content: '';
      position: fixed; inset: 0; z-index: 1; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.3;
    }

    /* ── Scroll reveal animation ─────────────────────── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }

    /* ── Keyframes ───────────────────────────────────── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(22px); }
      to   { opacity: 1; transform: translateY(0);    }
    }
    @keyframes scroll-left {
      0%   { transform: translateX(0);    }
      100% { transform: translateX(-50%); }
    }
  </style>
</head>
<body>
  <!-- The canvas and cursor are injected by ParticleCanvas and CustomCursor components -->
  <slot />

  <!-- ── Scroll reveal observer ──────────────────────────── -->
  <script>
    const obs = new IntersectionObserver(
      entries => entries.forEach(e => e.isIntersecting && e.target.classList.add('visible')),
      { threshold: 0.08 }
    );
    document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
  </script>
</body>
</html>
