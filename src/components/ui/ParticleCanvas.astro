---
// ── src/components/ui/ParticleCanvas.astro ───────────────────────
// Modernised constellation particle canvas — same space vibe,
// cleaner class-based architecture, fully driven by CMS settings.
// Receives particle config from siteSettings so you can tune
// count, speed, connection distance, and mouse repel from the Studio.

interface Props {
  count:              number;  // How many star particles
  speed:              number;  // Base velocity multiplier
  connectionDistance: number;  // Max px distance for constellation lines
  mouseRepelRadius:   number;  // Radius around cursor that repels particles
  accentColor:        string;  // CSS hex — used for cursor-linked lines
}

const { count, speed, connectionDistance, mouseRepelRadius, accentColor } = Astro.props;
---

<canvas id="tg-canvas"></canvas>

<style>
  #tg-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script define:vars={{ count, speed, connectionDistance, mouseRepelRadius, accentColor }}>
// ══════════════════════════════════════════════════════════════════
// TumeloGaming — Constellation Canvas
// Modernised rewrite: class-based, RAF-pooled, CMS-configurable.
// ══════════════════════════════════════════════════════════════════

const canvas = /** @type {HTMLCanvasElement} */ (document.getElementById('tg-canvas'));
const ctx    = canvas.getContext('2d');

// ── State ───────────────────────────────────────────────────────
let W, H;
let particles = [];
const mouse   = { x: -9999, y: -9999 };

// ── Nebula blobs (soft background glows) ────────────────────────
// Positions are expressed as fractions of W/H so they scale with viewport.
const NEBULA_BLOBS = [
  { fx: 0.15, fy: 0.20, fr: 220, c: '60,20,120'  },
  { fx: 0.80, fy: 0.70, fr: 200, c: '10,80,120'  },
  { fx: 0.50, fy: 0.50, fr: 280, c: '30,10,80'   },
];

// ── Particle colour distribution ────────────────────────────────
// 60% white-ish stars, 25% purple-tinted, 15% cyan-tinted
const COLOUR_ROLLS = [
  { threshold: 0.60, rgb: '255,255,255' },
  { threshold: 0.85, rgb: '180,160,255' },
  { threshold: 1.00, rgb: '100,220,255' },
];

// ── Resize ──────────────────────────────────────────────────────
function resize() {
  W = canvas.width  = window.innerWidth;
  H = canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

// ── Mouse tracking ───────────────────────────────────────────────
window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });

// ── Particle class ───────────────────────────────────────────────
class Particle {
  constructor(scatter = false) { this.reset(scatter); }

  reset(scatter = false) {
    // scatter = true: place anywhere in viewport (initial spawn)
    // scatter = false: enter from a random edge (respawn after leaving)
    this.x  = scatter ? Math.random() * W : (Math.random() > 0.5 ? -10 : W + 10);
    this.y  = scatter ? Math.random() * H : (Math.random() > 0.5 ? -10 : H + 10);

    // Speed is scaled by the CMS 'speed' setting
    this.vx = (Math.random() - 0.5) * speed * 0.7;
    this.vy = (Math.random() - 0.5) * speed * 0.7;

    this.r    = Math.random() * 1.8 + 0.5;                  // radius
    this.base_opacity = Math.random() * 0.6 + 0.2;

    // Pulse makes each star gently breathe
    this.pulse      = Math.random() * Math.PI * 2;
    this.pulseSpeed = Math.random() * 0.02 + 0.005;

    // Pick colour based on roll distribution
    const roll = Math.random();
    this.rgb = COLOUR_ROLLS.find(c => roll < c.threshold)?.rgb ?? '255,255,255';
  }

  update() {
    this.pulse += this.pulseSpeed;
    this.x += this.vx;
    this.y += this.vy;

    // Wrap around edges
    if (this.x < -20)    this.x = W + 20;
    if (this.x > W + 20) this.x = -20;
    if (this.y < -20)    this.y = H + 20;
    if (this.y > H + 20) this.y = -20;

    // Mouse repulsion — particles are gently pushed away from cursor
    const dx = this.x - mouse.x;
    const dy = this.y - mouse.y;
    const d  = Math.hypot(dx, dy);
    if (d < mouseRepelRadius && d > 0) {
      const force = ((mouseRepelRadius - d) / mouseRepelRadius) * 0.4;
      this.x += (dx / d) * force;
      this.y += (dy / d) * force;
    }
  }

  draw() {
    // Pulsing opacity
    const opacity = this.base_opacity * (0.7 + 0.3 * Math.sin(this.pulse));

    // Outer soft glow (radial gradient)
    const glow = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.r * 3.5);
    glow.addColorStop(0, `rgba(${this.rgb},${opacity})`);
    glow.addColorStop(1, `rgba(${this.rgb},0)`);
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.r * 3.5, 0, Math.PI * 2);
    ctx.fillStyle = glow;
    ctx.fill();

    // Hard bright centre dot
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
    ctx.fillStyle = `rgba(${this.rgb},${Math.min(opacity + 0.3, 1)})`;
    ctx.fill();
  }
}

// ── Initial particle spawn ───────────────────────────────────────
for (let i = 0; i < count; i++) particles.push(new Particle(true));

// ── Nebula soft glow blobs ───────────────────────────────────────
function drawNebula() {
  NEBULA_BLOBS.forEach(b => {
    const x = b.fx * W, y = b.fy * H;
    const g = ctx.createRadialGradient(x, y, 0, x, y, b.fr);
    g.addColorStop(0, `rgba(${b.c},0.18)`);
    g.addColorStop(1, `rgba(${b.c},0)`);
    ctx.beginPath();
    ctx.arc(x, y, b.fr, 0, Math.PI * 2);
    ctx.fillStyle = g;
    ctx.fill();
  });
}

// ── Constellation lines ──────────────────────────────────────────
// Draws lines between nearby particles and from each particle to
// the cursor when within mouseRepelRadius.
function drawLines() {
  for (let i = 0; i < particles.length; i++) {
    const a = particles[i];

    for (let j = i + 1; j < particles.length; j++) {
      const b  = particles[j];
      const d  = Math.hypot(a.x - b.x, a.y - b.y);

      if (d < connectionDistance) {
        // Boost opacity when cursor is near either endpoint
        const nearMouse =
          Math.hypot(a.x - mouse.x, a.y - mouse.y) < mouseRepelRadius ||
          Math.hypot(b.x - mouse.x, b.y - mouse.y) < mouseRepelRadius;

        const alpha = (1 - d / connectionDistance) * 0.25 * (nearMouse ? 2.5 : 1);

        const grad = ctx.createLinearGradient(a.x, a.y, b.x, b.y);
        grad.addColorStop(0, `rgba(${a.rgb},${alpha})`);
        grad.addColorStop(1, `rgba(${b.rgb},${alpha})`);

        ctx.beginPath();
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = grad;
        ctx.lineWidth   = 0.6;
        ctx.stroke();
      }
    }

    // Cursor-to-particle thread — purple accent line
    const distToCursor = Math.hypot(a.x - mouse.x, a.y - mouse.y);
    if (distToCursor < mouseRepelRadius) {
      const alpha = (1 - distToCursor / mouseRepelRadius) * 0.5;
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(mouse.x, mouse.y);
      // accentColor comes from CMS; default '#8b5cf6'
      ctx.strokeStyle = accentColor + Math.round(alpha * 255).toString(16).padStart(2, '0');
      ctx.lineWidth   = 0.8;
      ctx.stroke();
    }
  }
}

// ── Animation loop ───────────────────────────────────────────────
function animate() {
  ctx.clearRect(0, 0, W, H);
  drawNebula();
  drawLines();
  particles.forEach(p => { p.update(); p.draw(); });
  requestAnimationFrame(animate);
}
animate();
</script>
