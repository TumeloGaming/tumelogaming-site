---
// ── src/components/ui/SectionRenderer.astro ─────────────────────
// THE HEART OF THE PAGE BUILDER.
//
// This component receives the ordered `sections[]` array from Sanity
// and renders whichever section component matches the _type field,
// in whatever order they appear in the CMS.
//
// Adding, removing, or reordering sections in Sanity Studio
// automatically changes what this component renders — zero code changes needed.
//
// Each section is wrapped in a visibility check: if `visible === false`,
// the section is skipped entirely (not even rendered to the DOM).

import type { Section } from '../../lib/sanity';
import type { SiteSettings } from '../../lib/sanity';

import HeroSection      from '../sections/HeroSection.astro';
import PositionsSection from '../sections/PositionsSection.astro';
import ProjectsSection  from '../sections/ProjectsSection.astro';
import ServersSection   from '../sections/ServersSection.astro';
import ContactSection   from '../sections/ContactSection.astro';
import RichTextSection  from '../sections/RichTextSection.astro';

interface Props {
  sections: Section[];
  settings: SiteSettings;  // Passed through to ContactSection for global fallback
}

const { sections, settings } = Astro.props;
---

{sections?.map((section) => {
  // Skip hidden sections — they are fully absent from the DOM
  if (section.visible === false) return null;

  // Route to the correct component based on Sanity's _type field
  switch (section._type) {
    case 'heroSection':
      return <HeroSection data={section} />;

    case 'positionsSection':
      return <PositionsSection data={section} />;

    case 'projectsSection':
      return <ProjectsSection data={section} />;

    case 'serversSection':
      return <ServersSection data={section} />;

    case 'contactSection':
      return <ContactSection data={section} settings={settings} />;

    case 'richTextSection':
      return <RichTextSection data={section} />;

    default:
      // Unknown section type — fail silently in production, log in dev
      if (import.meta.env.DEV) {
        console.warn(`[SectionRenderer] Unknown section type: ${(section as any)._type}`);
      }
      return null;
  }
})}
