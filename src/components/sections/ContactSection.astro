---
// ── src/components/sections/ContactSection.astro ─────────────────
// Contact modal trigger — a subtle section that lives in the footer area.
// The modal itself is rendered globally and toggled by JS.

import type { ContactSection, SiteSettings } from '../../lib/sanity';

interface Props { data: ContactSection; settings: SiteSettings; }
const { data, settings } = Astro.props;

// If useGlobal is true (default), pull from siteSettings.
// Otherwise use the per-section overrides.
const discord    = data.useGlobal ? settings.contact.discord    : (data.discord    ?? settings.contact.discord);
const discordUrl = data.useGlobal ? settings.contact.discordUrl : (data.discordUrl ?? settings.contact.discordUrl);
const email      = data.useGlobal ? settings.contact.email      : (data.email      ?? settings.contact.email);
---

<!-- The contact button sits in the footer, triggers the modal -->
<footer>
  <div class="footer-left">
    <span class="footer-logo">TUMELOGAMING</span>
    <p class="footer-tagline">Gamer · Developer · Streamer</p>
  </div>
  <div class="footer-right">
    <span class="footer-credit">{settings.footerCredit}</span>
    <button class="btn-contact" id="open-contact" data-cursor-hover>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
      Contact Me
    </button>
  </div>
</footer>

<!-- Contact modal (hidden by default) -->
<div class="modal-overlay" id="contact-modal">
  <div class="modal" role="dialog" aria-modal="true" aria-label="Contact">
    <button class="modal-close" id="close-contact" aria-label="Close">✕</button>
    <p class="modal-title">Get in Touch</p>
    <p class="modal-desc">Pick how you'd like to reach me.</p>
    <div class="contact-opts">
      {discordUrl
        ? <a href={discordUrl} target="_blank" rel="noopener noreferrer" class="contact-opt discord" data-cursor-hover>
            <span class="ci d">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="#5865f2"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            </span>
            <div><p class="co-label">Discord</p><p class="co-val">{discord}</p></div>
          </a>
        : null
      }
      {email &&
        <a href={`mailto:${email}`} class="contact-opt email" data-cursor-hover>
          <span class="ci e">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </span>
          <div><p class="co-label">Email</p><p class="co-val">{email}</p></div>
        </a>
      }
    </div>
  </div>
</div>

<style>
  footer {
    position: relative; z-index: 2;
    border-top: 1px solid var(--border);
    display: grid; grid-template-columns: 1fr 1fr;
  }
  .footer-left { padding: 44px var(--section-pad, 64px); border-right: 1px solid var(--border); }
  .footer-logo {
    font-family: var(--font-display); font-size: 26px; font-weight: 900;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    letter-spacing: 0.06em; margin-bottom: 6px; display: block;
  }
  .footer-tagline { font-size: 13px; color: var(--text-muted); }
  .footer-right {
    padding: 44px var(--section-pad, 64px);
    display: flex; align-items: center; justify-content: flex-end; gap: 20px;
  }
  .footer-credit { font-family: var(--font-mono); font-size: 11px; color: rgba(255,255,255,0.11); letter-spacing: 0.08em; }
  .btn-contact {
    display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px;
    border-radius: 11px; background: var(--surface); border: 1px solid var(--border);
    color: var(--text-dim); font-family: var(--font-body); font-size: 13px; font-weight: 600;
    cursor: pointer; transition: all 0.25s;
  }
  .btn-contact:hover { border-color: rgba(139,92,246,0.4); color: var(--accent); background: rgba(139,92,246,0.08); transform: translateY(-1px); }

  /* ── Modal ─────────────────────────────────────────────── */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 200;
    background: rgba(6,6,15,0.82); backdrop-filter: blur(12px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.3s;
  }
  .modal-overlay.open { opacity: 1; pointer-events: all; }
  .modal {
    background: #0e0e1c; border: 1px solid rgba(139,92,246,0.25);
    border-radius: 24px; padding: 40px; width: 100%; max-width: 400px;
    box-shadow: 0 0 80px rgba(139,92,246,0.12), 0 40px 60px rgba(0,0,0,0.5);
    transform: scale(0.95) translateY(16px); transition: transform 0.3s;
    position: relative; text-align: center;
  }
  .modal-overlay.open .modal { transform: scale(1) translateY(0); }
  .modal-title {
    font-family: var(--font-display); font-size: 20px; font-weight: 700; margin-bottom: 8px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .modal-desc { font-size: 13px; color: var(--text-muted); margin-bottom: 28px; line-height: 1.6; }
  .contact-opts { display: flex; flex-direction: column; gap: 12px; }
  .contact-opt {
    display: flex; align-items: center; gap: 16px; padding: 15px 18px;
    border-radius: 13px; background: var(--surface); border: 1px solid var(--border);
    text-decoration: none; color: var(--text); transition: all 0.25s; text-align: left;
  }
  .contact-opt.discord:hover { border-color: rgba(88,101,242,0.5); background: rgba(88,101,242,0.09); transform: translateX(4px); }
  .contact-opt.email:hover   { border-color: rgba(6,182,212,0.5);  background: rgba(6,182,212,0.08);  transform: translateX(4px); }
  .ci { width: 42px; height: 42px; border-radius: 11px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .ci.d { background: rgba(88,101,242,0.15); border: 1px solid rgba(88,101,242,0.25); }
  .ci.e { background: rgba(6,182,212,0.12);  border: 1px solid rgba(6,182,212,0.25);  }
  .co-label { font-family: var(--font-display); font-size: 13px; font-weight: 700; margin-bottom: 3px; }
  .co-val   { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }
  .modal-close {
    position: absolute; top: 14px; right: 18px; background: none; border: none;
    color: var(--text-muted); font-size: 20px; cursor: pointer; padding: 4px 8px;
    border-radius: 6px; transition: color 0.2s; line-height: 1;
  }
  .modal-close:hover { color: var(--text); }

  @media (max-width: 1100px) {
    footer { grid-template-columns: 1fr; }
    .footer-left { border-right: none; border-bottom: 1px solid var(--border); padding: 36px 32px; }
    .footer-right { padding: 32px; justify-content: flex-start; }
  }
</style>

<script>
  const overlay = document.getElementById('contact-modal');
  document.getElementById('open-contact')?.addEventListener('click',  () => overlay?.classList.add('open'));
  document.getElementById('close-contact')?.addEventListener('click', () => overlay?.classList.remove('open'));
  overlay?.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('open'); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') overlay?.classList.remove('open'); });
</script>
