---
// ── src/components/sections/ProjectsSection.astro ────────────────
// Project cards grid. Each card can link to an external URL
// OR to a dedicated detail page at /projects/[slug] if hasDetailPage is true.

import type { ProjectsSection } from '../../lib/sanity';
import { imageUrl } from '../../lib/sanity';

interface Props { data: ProjectsSection; }
const { data } = Astro.props;

const PLATFORM_ICONS: Record<string, string> = {
  discord: `<svg width="14" height="14" viewBox="0 0 24 24" fill="#5865f2"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>`,
  github:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="rgba(255,255,255,0.65)"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
  web:     `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
  mc:      `<svg width="14" height="14" viewBox="0 0 24 24" fill="#4ade80"><rect x="2" y="2" width="9" height="9" rx="1"/><rect x="13" y="2" width="9" height="9" rx="1"/><rect x="2" y="13" width="9" height="9" rx="1"/><rect x="13" y="13" width="9" height="9" rx="1"/></svg>`,
  youtube: `<svg width="14" height="14" viewBox="0 0 24 24" fill="#ef4444"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  twitch:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="#8b5cf6"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg>`,
};

const projects = data.projects ?? [];
---

<section class="projects-section reveal" id="projects">
  <div class="proj-header">
    <div>
      <span class="mlabel" style="margin-bottom:12px;display:block">{data.sectionLabel}</span>
      <h2>{data.sectionTitle ?? 'My Projects'}</h2>
    </div>
    <p>{data.sectionDesc}</p>
  </div>

  <div class="proj-grid">
    {projects.map(p => {
      // Thumbnail: Sanity image > emoji fallback
      const thumbUrl = p.thumbnail ? imageUrl(p.thumbnail, 104, 104) : null;
      // Card link: detail page if available, otherwise external link
      const cardHref = p.hasDetailPage ? `/projects/${p.slug}` : p.externalLink;

      return (
        <div class="proj-card" data-cursor-hover>
          <div class="proj-top">
            <div class="proj-pfp">
              {thumbUrl
                ? <img src={thumbUrl} alt={p.title} loading="lazy" />
                : (p.thumbnailEmoji ?? '🛠️')
              }
            </div>
            <div class={`plat plat-${p.platform ?? 'web'}`}
                 title={p.platform ?? 'web'}
                 set:html={PLATFORM_ICONS[p.platform ?? 'web'] ?? PLATFORM_ICONS.web} />
          </div>
          <div class="proj-body">
            <p class="proj-title">{p.title}</p>
            <p class="proj-desc">{p.description}</p>
            <div class="proj-actions">
              {cardHref && (
                <a href={cardHref}
                   target={p.hasDetailPage ? '_self' : '_blank'}
                   rel={p.hasDetailPage ? '' : 'noopener noreferrer'}
                   class="proj-link">
                  {p.hasDetailPage ? 'View Project →' : (p.externalLinkText ?? 'Visit →')}
                </a>
              )}
              {p.hasDetailPage && p.externalLink && (
                <a href={p.externalLink} target="_blank" rel="noopener noreferrer" class="proj-link-ext">
                  {p.externalLinkText ?? 'External ↗'}
                </a>
              )}
            </div>
          </div>
        </div>
      );
    })}

    <!-- "More coming soon" placeholder -->
    <div class="proj-card placeholder">
      <div class="plus">＋</div>
      <p>More coming soon</p>
    </div>
  </div>
</section>

<style>
  .projects-section { position: relative; z-index: 2; padding: 0 var(--section-pad, 64px) 100px; }

  .proj-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    padding-bottom: 28px; border-bottom: 1px solid var(--border); margin-bottom: 28px;
  }
  .proj-header h2 { font-family: var(--font-display); font-size: 30px; font-weight: 700; letter-spacing: -0.01em; }
  .proj-header p  { font-size: 13px; color: var(--text-muted); max-width: 240px; text-align: right; line-height: 1.6; }

  .mlabel {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--accent);
    padding: 5px 14px; border: 1px solid rgba(139,92,246,0.3); border-radius: 100px;
    background: rgba(139,92,246,0.08); display: inline-flex; align-items: center;
    white-space: nowrap;
  }

  .proj-grid { display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-start; }

  .proj-card {
    width: 260px; background: var(--surface); border: 1px solid var(--border);
    border-radius: 20px; overflow: hidden; display: flex; flex-direction: column;
    transition: all 0.3s; flex-shrink: 0;
  }
  .proj-card:hover { border-color: rgba(139,92,246,0.25); transform: translateY(-4px); box-shadow: 0 20px 50px rgba(0,0,0,0.45); }

  .proj-top { padding: 22px 22px 0; display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
  .proj-pfp {
    width: 52px; height: 52px; border-radius: 13px; border: 1px solid var(--border);
    background: var(--surface2); display: flex; align-items: center; justify-content: center;
    font-size: 22px; overflow: hidden; flex-shrink: 0;
  }
  .proj-pfp img { width: 100%; height: 100%; object-fit: cover; }

  .plat {
    width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center;
    justify-content: center; border: 1px solid var(--border); background: var(--surface2);
    flex-shrink: 0; transition: transform 0.2s;
  }
  .proj-card:hover .plat { transform: scale(1.1); }
  .plat-discord { background: rgba(88,101,242,0.15);  border-color: rgba(88,101,242,0.3);  }
  .plat-github  { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); }
  .plat-web     { background: rgba(6,182,212,0.1);    border-color: rgba(6,182,212,0.25);  }
  .plat-mc      { background: rgba(34,197,94,0.1);    border-color: rgba(34,197,94,0.25);  }
  .plat-youtube { background: rgba(239,68,68,0.12);   border-color: rgba(239,68,68,0.25);  }
  .plat-twitch  { background: rgba(139,92,246,0.12);  border-color: rgba(139,92,246,0.25); }

  .proj-body { padding: 0 22px 22px; display: flex; flex-direction: column; flex: 1; }
  .proj-title { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 7px; letter-spacing: 0.02em; }
  .proj-desc  { font-size: 12px; color: var(--text-dim); line-height: 1.6; margin-bottom: 16px; flex: 1; }

  .proj-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .proj-link {
    display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600;
    color: var(--accent); text-decoration: none; transition: gap 0.2s;
  }
  .proj-link:hover { gap: 8px; }
  .proj-link-ext {
    font-size: 11px; color: var(--text-muted); text-decoration: none;
    transition: color 0.2s;
  }
  .proj-link-ext:hover { color: var(--accent2); }

  .proj-card.placeholder {
    background: transparent; border-style: dashed;
    align-items: center; justify-content: center; text-align: center;
    min-height: 200px; padding: 32px;
  }
  .proj-card.placeholder .plus { font-size: 30px; color: rgba(255,255,255,0.07); margin-bottom: 10px; }
  .proj-card.placeholder p { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); letter-spacing: 0.08em; }

  @media (max-width: 1100px) {
    .projects-section { padding: 0 32px 80px; }
    .proj-header { flex-direction: column; align-items: flex-start; gap: 12px; }
    .proj-header p { text-align: left; max-width: 100%; }
  }
</style>
