---
// ── src/components/sections/HeroSection.astro ────────────────────
// Full-viewport hero with name, pronouns, bio, skills marquee,
// stats sidebar, and social buttons. All content from Sanity CMS.

import type { HeroSection } from '../../lib/sanity';

interface Props { data: HeroSection; }
const { data } = Astro.props;

// Social platform SVG icons (inline, no external dependency)
const SOCIAL_ICONS: Record<string, string> = {
  twitch:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg>`,
  tiktok:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.94a8.2 8.2 0 004.83 1.56V7.07a4.85 4.85 0 01-1.06-.38z"/></svg>`,
  twitter: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  youtube: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  discord: `<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>`,
  github:  `<svg width="14" height="14" viewBox="0 0 24 24" fill="rgba(255,255,255,0.65)"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`,
};

// Active socials only
const socials = (data.socials ?? []).filter(s => s.enabled && s.url);
---

<section class="hero" id="about">
  <!-- Fading vertical divider between left and right columns -->
  <div class="hero-divider" aria-hidden="true"></div>

  <!-- ── Left column ──────────────────────────────────────── -->
  <div class="hero-left">
    <p class="hero-eyebrow">Welcome to my space</p>

    <h1 class="hero-name">
      <span class="l1">{data.name1}</span>
      <span class="l2">{data.name2}</span>
    </h1>

    <span class="hero-pronouns">{data.pronouns}</span>

    <p class="hero-bio">{data.tagline}</p>

    <!-- Skills marquee — items are doubled for a seamless infinite loop -->
    <div class="marquee-row">
      <span class="marquee-label-pill mlabel">Skills</span>
      <div class="marquee-clip">
        <div class="marquee-track">
          {[...( data.skills ?? []), ...(data.skills ?? [])].map(skill => (
            <span class="skill-badge" data-cursor-hover>{skill}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Social buttons -->
    <div class="hero-ctas">
      {socials.map(s => (
        <a href={s.url} target="_blank" rel="noopener noreferrer"
           class={`btn-social ${s.id}`} data-cursor-hover>
          <span set:html={SOCIAL_ICONS[s.id] ?? ''} />
          {s.label}
        </a>
      ))}
    </div>
  </div>

  <!-- ── Right sidebar ────────────────────────────────────── -->
  <div class="hero-right">
    <!-- Stats -->
    <div class="stat-block">
      <div class="stat-num">{data.stats?.servers ?? '17'}</div>
      <div class="stat-lbl">{data.stats?.serversLabel ?? 'MC Servers Staffed'}</div>
    </div>
    <div class="stat-sep"></div>
    <div class="stat-block">
      <div class="stat-num">{data.stats?.experience ?? '3+'}</div>
      <div class="stat-lbl">{data.stats?.experienceLabel ?? 'Years Experience'}</div>
    </div>
  </div>
</section>

<style>
  /* ── Hero layout ─────────────────────────────────────── */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr var(--sidebar-w, 260px);
    position: relative;
    z-index: 2;
  }

  .hero-divider {
    position: absolute; top: 0; bottom: 0; right: var(--sidebar-w, 260px); width: 1px;
    background: linear-gradient(to bottom,
      transparent 0%, transparent 10%,
      rgba(139,92,246,0.2) 30%, rgba(6,182,212,0.14) 70%,
      transparent 90%, transparent 100%);
    pointer-events: none; z-index: 3;
  }

  /* ── Left column ─────────────────────────────────────── */
  .hero-left {
    padding: 130px 64px 80px;
    display: flex; flex-direction: column; justify-content: center;
    position: relative; overflow: hidden; min-width: 0;
  }
  /* Large watermark "TG" letters in the background */
  .hero-left::before {
    content: 'TG';
    position: absolute; bottom: -40px; left: -20px;
    font-family: var(--font-display); font-size: 280px; font-weight: 900;
    color: rgba(139,92,246,0.04); line-height: 1;
    pointer-events: none; user-select: none; z-index: 0;
  }
  .hero-left > * { position: relative; z-index: 1; }

  .hero-eyebrow {
    font-family: var(--font-mono); font-size: 11px; color: var(--accent);
    letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 24px;
    display: flex; align-items: center; gap: 12px;
    opacity: 0; animation: fadeUp 0.8s 0.2s forwards;
  }
  .hero-eyebrow::before {
    content: ''; display: block; width: 32px; height: 1px;
    background: var(--accent); flex-shrink: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(50px, 6.5vw, 88px); font-weight: 900;
    line-height: 0.92; letter-spacing: -0.03em; margin-bottom: 20px;
    opacity: 0; animation: fadeUp 0.8s 0.35s forwards;
  }
  .hero-name .l1 {
    display: block;
    background: linear-gradient(120deg, #fff 0%, #c4b5fd 60%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .hero-name .l2 {
    display: block;
    background: linear-gradient(120deg, var(--accent) 0%, var(--accent2) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  .hero-pronouns {
    display: inline-flex; align-items: center; padding: 4px 12px; border-radius: 100px;
    background: rgba(244,114,182,0.08); border: 1px solid rgba(244,114,182,0.2);
    font-family: var(--font-mono); font-size: 11px; color: var(--accent3);
    letter-spacing: 0.06em; margin-bottom: 20px; align-self: flex-start;
    opacity: 0; animation: fadeUp 0.8s 0.45s forwards;
  }

  .hero-bio {
    font-size: 15px; color: var(--text-dim); line-height: 1.75; max-width: 480px;
    border-left: 2px solid rgba(139,92,246,0.3); padding-left: 20px; margin-bottom: 24px;
    opacity: 0; animation: fadeUp 0.8s 0.55s forwards;
  }

  /* ── Skills Marquee ──────────────────────────────────── */
  .marquee-row {
    display: flex; align-items: center; gap: 0;
    margin-bottom: 32px; width: 100%; overflow: hidden; position: relative;
    opacity: 0; animation: fadeUp 0.8s 0.65s forwards;
  }
  .marquee-label-pill { flex-shrink: 0; margin-right: 14px; z-index: 3; }
  .mlabel {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--accent);
    padding: 5px 14px; border: 1px solid rgba(139,92,246,0.3); border-radius: 100px;
    background: rgba(139,92,246,0.08); display: inline-flex; align-items: center;
    white-space: nowrap; flex-shrink: 0;
  }
  .marquee-clip {
    flex: 1; overflow: hidden; position: relative; min-width: 0;
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 80%, transparent 100%);
  }
  .marquee-track {
    display: flex; gap: 10px; width: max-content;
    animation: scroll-left 22s linear infinite;
  }
  .marquee-track:hover { animation-play-state: paused; }

  .skill-badge {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: 11px;
    padding: 6px 14px; border-radius: 100px;
    border: 1px solid var(--border); color: var(--text-muted);
    background: var(--surface); letter-spacing: 0.05em;
    white-space: nowrap; flex-shrink: 0;
    transition: border-color 0.2s, color 0.2s;
    cursor: default;
  }
  .skill-badge:hover { border-color: rgba(139,92,246,0.35); color: var(--accent); }

  /* ── Social buttons ──────────────────────────────────── */
  .hero-ctas {
    display: flex; gap: 12px; flex-wrap: wrap;
    opacity: 0; animation: fadeUp 0.8s 0.8s forwards;
  }
  .btn-social {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 20px; border-radius: 12px; font-size: 13px; font-weight: 600;
    text-decoration: none; transition: all 0.25s; letter-spacing: 0.02em;
    border: 1px solid var(--border); background: var(--surface); color: var(--text-dim);
  }
  .btn-social:hover { transform: translateY(-2px); }
  .btn-social.twitch:hover  { border-color: rgba(145,71,255,0.5); color: #9147ff; background: rgba(145,71,255,0.08); box-shadow: 0 0 20px rgba(145,71,255,0.15); }
  .btn-social.tiktok:hover  { border-color: rgba(255,255,255,0.2); color: #fff; background: rgba(255,255,255,0.06); }
  .btn-social.twitter:hover { border-color: rgba(255,255,255,0.25); color: #e7e7e7; background: rgba(255,255,255,0.07); }
  .btn-social.youtube:hover { border-color: rgba(239,68,68,0.5); color: #ef4444; background: rgba(239,68,68,0.08); box-shadow: 0 0 20px rgba(239,68,68,0.12); }
  .btn-social.discord:hover { border-color: rgba(88,101,242,0.5); color: #5865f2; background: rgba(88,101,242,0.08); }

  /* ── Right sidebar ───────────────────────────────────── */
  .hero-right {
    padding: 130px 28px 80px 32px;
    display: flex; flex-direction: column; justify-content: center; gap: 22px;
    position: relative; z-index: 2;
  }
  .stat-num {
    font-family: var(--font-display); font-size: 34px; font-weight: 900;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    line-height: 1;
  }
  .stat-lbl {
    font-family: var(--font-mono); font-size: 10px;
    color: var(--text-muted); letter-spacing: 0.1em; margin-top: 3px;
  }
  .stat-sep { height: 1px; background: rgba(255,255,255,0.05); }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 1100px) {
    .hero { grid-template-columns: 1fr; }
    .hero-divider { display: none; }
    .hero-left { padding: 100px 32px 40px; }
    .hero-right {
      padding: 32px; flex-direction: row; flex-wrap: wrap;
      gap: 20px; justify-content: space-around;
      border-top: 1px solid var(--border);
    }
  }
</style>
