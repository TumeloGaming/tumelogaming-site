---
// ── src/components/sections/PositionsSection.astro ───────────────
// "Current Positions" — role cards with icon, tag, title, and link.
// Hidden cards (visible === false) are skipped at the data level.

import type { PositionsSection } from '../../lib/sanity';

interface Props { data: PositionsSection; }
const { data } = Astro.props;

// Only render cards whose `visible` flag is true
const visiblePositions = (data.positions ?? []).filter(p => p.visible !== false);

// Tag colour → CSS class mapping
const TAG_CLASS: Record<string, string> = {
  cyan: 'cyan', purple: 'purple', pink: 'pink', yellow: 'yellow',
};
---

<section class="section-wrap reveal" id="positions">
  <!-- Left sticky label column -->
  <div class="sec-label-col">
    <div class="sec-num">{data.sectionNumber ?? '01'}</div>
    <h2 class="sec-title">{data.sectionTitle ?? 'Current Positions'}</h2>
    <p class="sec-desc">{data.sectionDesc}</p>
  </div>

  <!-- Position cards grid -->
  <div class="cards-flow">
    {visiblePositions.map(pos => (
      <div class="pos-card" data-cursor-hover>
        <span class="c-icon">{pos.icon}</span>
        <span class={`c-tag ${TAG_CLASS[pos.tagColor] ?? 'cyan'}`}>{pos.tag}</span>
        <p class="c-title">{pos.title}</p>
        <p class="c-sub">{pos.subtitle}</p>
        <p class="c-desc">{pos.description}</p>
        {pos.link && (
          <a href={pos.link} target="_blank" rel="noopener noreferrer" class="c-link">
            {pos.linkText ?? 'Visit'} →
          </a>
        )}
      </div>
    ))}

    <!-- "Open to Roles" placeholder card — toggled from CMS -->
    {data.showOpenToRoles && (
      <div class="pos-card placeholder">
        <span style="font-size:24px;margin-bottom:8px">✦</span>
        <p class="c-title" style="color:var(--text-muted);font-size:11px">Open to Roles</p>
        <p class="c-desc" style="font-size:11px">Got an offer?</p>
      </div>
    )}
  </div>
</section>

<style>
  .section-wrap {
    position: relative; z-index: 2;
    padding: 100px var(--section-pad, 64px);
    display: grid; grid-template-columns: 220px 1fr; gap: 56px; align-items: start;
  }
  .sec-label-col { position: sticky; top: 100px; }
  .sec-num {
    font-family: var(--font-display); font-size: 76px; font-weight: 900;
    color: rgba(139,92,246,0.07); line-height: 1; margin-bottom: -14px; letter-spacing: -0.04em;
  }
  .sec-title {
    font-family: var(--font-display); font-size: 19px; font-weight: 700;
    color: var(--text); letter-spacing: 0.01em; margin-bottom: 14px;
  }
  .sec-desc { font-size: 13px; color: var(--text-muted); line-height: 1.65; }

  .cards-flow { display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-start; }

  .pos-card {
    width: 240px; background: var(--surface); border: 1px solid var(--border);
    border-radius: 20px; padding: 24px 26px; transition: all 0.3s;
    position: relative; overflow: hidden; flex-shrink: 0;
  }
  .pos-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139,92,246,0.5), transparent);
    opacity: 0; transition: opacity 0.3s;
  }
  .pos-card:hover { border-color: rgba(139,92,246,0.25); transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,0.4); }
  .pos-card:hover::before { opacity: 1; }
  .pos-card.placeholder {
    border-style: dashed; background: transparent;
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; text-align: center; min-height: 180px;
  }

  .c-icon  { font-size: 24px; margin-bottom: 12px; display: block; }
  .c-tag   {
    font-family: var(--font-mono); font-size: 9px; padding: 3px 9px;
    border-radius: 100px; letter-spacing: 0.08em; display: inline-block; margin-bottom: 12px;
  }
  .c-tag.cyan   { background: rgba(6,182,212,0.1);   border: 1px solid rgba(6,182,212,0.2);   color: var(--accent2); }
  .c-tag.purple { background: rgba(139,92,246,0.1);  border: 1px solid rgba(139,92,246,0.2);  color: var(--accent);  }
  .c-tag.pink   { background: rgba(244,114,182,0.1); border: 1px solid rgba(244,114,182,0.2); color: var(--accent3); }
  .c-tag.yellow { background: rgba(251,191,36,0.1);  border: 1px solid rgba(251,191,36,0.2);  color: #fbbf24;        }

  .c-title { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 5px; letter-spacing: 0.02em; line-height: 1.3; }
  .c-sub   { font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); letter-spacing: 0.06em; margin-bottom: 10px; }
  .c-desc  { font-size: 13px; color: var(--text-dim); line-height: 1.6; margin-bottom: 16px; }
  .c-link  { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; color: var(--accent); text-decoration: none; transition: gap 0.2s; }
  .c-link:hover { gap: 9px; }

  @media (max-width: 1100px) {
    .section-wrap { grid-template-columns: 1fr; padding: 60px 32px; }
    .sec-label-col { position: static; }
  }
</style>
