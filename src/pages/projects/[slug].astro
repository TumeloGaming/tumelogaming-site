---
// ── src/pages/projects/[slug].astro ──────────────────────────────
// Dynamic route that generates one page per project document
// that has `hasDetailPage = true` set in Sanity.
//
// URL: /projects/tummulti-bot, /projects/password-generator, etc.
// Each page gets its own OG metadata set from the project's
// ogTitle, ogDescription, and ogImage fields in Sanity.
//
// getStaticPaths() tells Astro which slugs exist so it can
// pre-render all project pages at build time.

import { toHTML } from '@portabletext/to-html';
import Base           from '../../layouts/Base.astro';
import ParticleCanvas from '../../components/ui/ParticleCanvas.astro';
import CustomCursor   from '../../components/ui/CustomCursor.astro';
import Nav            from '../../components/ui/Nav.astro';
import {
  getAllProjectSlugs, getProjectBySlug, getSiteSettings, imageUrl,
} from '../../lib/sanity';

// ── Static paths ─────────────────────────────────────────────────
// Astro calls this at build time to know which slugs to pre-render.
export async function getStaticPaths() {
  const slugs = await getAllProjectSlugs();
  return slugs.map(slug => ({ params: { slug } }));
}

// ── Data fetching ────────────────────────────────────────────────
const { slug } = Astro.params;
const [project, settings] = await Promise.all([
  getProjectBySlug(slug),
  getSiteSettings(),
]);

// 404 if no matching project in Sanity
if (!project) return Astro.redirect('/404');

// Per-project OG values (fall back to global if not set)
const ogTitle = project.ogTitle || project.title;
const ogDesc  = project.ogDescription || project.description;
const ogImg   = project.ogImage || project.thumbnail;

// Thumbnail image URL (for the page header)
const thumbUrl = project.thumbnail ? imageUrl(project.thumbnail, 200, 200) : null;

// Render the Portable Text body to HTML (server-side, no JS needed)
const bodyHtml = project.body ? toHTML(project.body, {
  components: {
    types: {
      image: ({ value }: any) => {
        const url = imageUrl(value, 900);
        return `<figure class="rt-figure"><img src="${url}" alt="${value.alt ?? ''}" loading="lazy" />
          ${value.caption ? `<figcaption>${value.caption}</figcaption>` : ''}</figure>`;
      },
      codeBlock: ({ value }: any) => `
        <div class="rt-code-block">
          <span class="rt-code-lang">${value.language ?? 'code'}</span>
          <pre><code>${value.code ?? ''}</code></pre>
        </div>`,
    },
    marks: {
      link: ({ children, value }: any) =>
        `<a href="${value.href}" target="_blank" rel="noopener noreferrer" class="rt-link">${children}</a>`,
    },
    block: {
      blockquote: ({ children }: any) => `<blockquote class="rt-blockquote">${children}</blockquote>`,
    },
  },
}) : '';

// Platform icon lookup
const PLATFORM_ICONS: Record<string, string> = {
  web:     'Web',
  discord: 'Discord',
  github:  'GitHub',
  youtube: 'YouTube',
  twitch:  'Twitch',
  mc:      'Minecraft',
};
---

<Base
  pageTitle={ogTitle}
  pageDesc={ogDesc}
  pageImage={ogImg}
  canonical={`${import.meta.env.PUBLIC_SITE_URL}/projects/${slug}`}
>
  <ParticleCanvas
    count={settings.particles?.count              ?? 100}
    speed={settings.particles?.speed              ?? 0.35}
    connectionDistance={settings.particles?.connectionDistance ?? 140}
    mouseRepelRadius={settings.particles?.mouseRepelRadius  ?? 180}
    accentColor={settings.colors?.accent           ?? '#8b5cf6'}
  />
  <CustomCursor />
  <Nav navLogo={settings.navLogo ?? 'TG'} />

  <main class="project-detail">
    <!-- ── Back link ──────────────────────────────────────── -->
    <a href="/#projects" class="back-link">← Back to Projects</a>

    <!-- ── Project header ────────────────────────────────── -->
    <header class="proj-header">
      <div class="proj-icon">
        {thumbUrl
          ? <img src={thumbUrl} alt={project.title} />
          : <span>{project.thumbnailEmoji ?? '🛠️'}</span>
        }
      </div>
      <div class="proj-meta">
        {project.platform && (
          <span class="proj-platform">{PLATFORM_ICONS[project.platform] ?? project.platform}</span>
        )}
        <h1 class="proj-title">{project.title}</h1>
        {project.description && <p class="proj-desc">{project.description}</p>}
        {project.externalLink && (
          <a href={project.externalLink} target="_blank" rel="noopener noreferrer" class="proj-cta">
            {project.externalLinkText ?? 'Visit Project'} ↗
          </a>
        )}
      </div>
    </header>

    <!-- ── Rich text body ────────────────────────────────── -->
    {bodyHtml && (
      <article class="proj-body rt-body" set:html={bodyHtml} />
    )}
  </main>
</Base>

<style>
  .project-detail {
    position: relative; z-index: 2;
    max-width: 800px; margin: 0 auto;
    padding: 120px 32px 80px;
  }

  .back-link {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 12px; color: var(--text-muted);
    text-decoration: none; letter-spacing: 0.06em;
    margin-bottom: 40px; transition: color 0.2s;
  }
  .back-link:hover { color: var(--accent); }

  .proj-header {
    display: flex; align-items: flex-start; gap: 28px; margin-bottom: 48px;
  }
  .proj-icon {
    width: 80px; height: 80px; border-radius: 20px; flex-shrink: 0;
    border: 1px solid var(--border); background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    font-size: 36px; overflow: hidden;
  }
  .proj-icon img { width: 100%; height: 100%; object-fit: cover; }

  .proj-meta { flex: 1; }
  .proj-platform {
    font-family: var(--font-mono); font-size: 10px; color: var(--accent2);
    letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px; display: block;
  }
  .proj-title {
    font-family: var(--font-display); font-size: clamp(24px, 4vw, 40px);
    font-weight: 900; color: var(--text); line-height: 1.1; margin-bottom: 12px;
    background: linear-gradient(120deg, #fff 0%, #c4b5fd 60%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .proj-desc {
    font-size: 15px; color: var(--text-dim); line-height: 1.7; margin-bottom: 20px;
    max-width: 580px;
  }
  .proj-cta {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 22px; border-radius: 11px;
    background: rgba(139,92,246,0.1); border: 1px solid rgba(139,92,246,0.3);
    color: var(--accent); font-weight: 600; font-size: 13px;
    text-decoration: none; transition: all 0.25s;
  }
  .proj-cta:hover { background: rgba(139,92,246,0.2); transform: translateY(-1px); }

  /* ── Portable Text styles (shared with RichTextSection) ── */
  .rt-body :global(h2) { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--text); margin: 40px 0 16px; }
  .rt-body :global(h3) { font-family: var(--font-display); font-size: 17px; font-weight: 700; color: var(--text); margin: 28px 0 12px; }
  .rt-body :global(p)  { font-size: 15px; color: var(--text-dim); line-height: 1.8; margin-bottom: 16px; }
  .rt-body :global(strong) { color: var(--text); font-weight: 700; }
  .rt-body :global(code)   { font-family: var(--font-mono); font-size: 13px; background: rgba(139,92,246,0.1); color: var(--accent); padding: 2px 6px; border-radius: 4px; }
  .rt-body :global(.rt-link) { color: var(--accent2); text-decoration: underline; text-underline-offset: 3px; }
  .rt-body :global(.rt-blockquote) { border-left: 3px solid var(--accent); padding-left: 20px; margin: 24px 0; font-style: italic; color: var(--text-muted); }
  .rt-body :global(.rt-figure) { margin: 28px 0; }
  .rt-body :global(.rt-figure img) { width: 100%; border-radius: 12px; border: 1px solid var(--border); }
  .rt-body :global(.rt-figure figcaption) { font-size: 12px; color: var(--text-muted); margin-top: 8px; text-align: center; font-family: var(--font-mono); }
  .rt-body :global(.rt-code-block) { margin: 24px 0; border-radius: 12px; border: 1px solid var(--border); overflow: hidden; background: rgba(0,0,0,0.4); }
  .rt-body :global(.rt-code-lang) { display: block; font-family: var(--font-mono); font-size: 10px; color: var(--accent); padding: 8px 16px; border-bottom: 1px solid var(--border); letter-spacing: 0.1em; text-transform: uppercase; }
  .rt-body :global(.rt-code-block pre) { padding: 16px; overflow-x: auto; }
  .rt-body :global(.rt-code-block code) { background: none; color: var(--text-dim); font-size: 13px; padding: 0; }

  @media (max-width: 600px) {
    .proj-header { flex-direction: column; }
    .proj-icon { width: 64px; height: 64px; font-size: 28px; }
  }
</style>
