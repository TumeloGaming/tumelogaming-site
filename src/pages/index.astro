---
// ── src/pages/index.astro ─────────────────────────────────────────
// The homepage. Fetches the page with slug "/" from Sanity and passes
// its sections array to SectionRenderer, which dispatches each section
// to the correct component. The order in Sanity = the order on screen.

import Base             from '../layouts/Base.astro';
import ParticleCanvas   from '../components/ui/ParticleCanvas.astro';
import CustomCursor     from '../components/ui/CustomCursor.astro';
import Nav              from '../components/ui/Nav.astro';
import SectionRenderer  from '../components/ui/SectionRenderer.astro';
import { getPageBySlug, getSiteSettings } from '../lib/sanity';

// Fetch in parallel — both are needed before we can render
const [page, settings] = await Promise.all([
  getPageBySlug('/'),
  getSiteSettings(),
]);

// Guard: if no homepage exists in Sanity yet, show a friendly message
if (!page) {
  // This only appears if the CMS has no page with slug "/"
  // After running the migration script and publishing, this won't happen.
}
---

<Base
  pageTitle={page?.seoTitle}
  pageDesc={page?.seoDescription}
  pageImage={page?.seoImage}
>
  <!-- ── Background layers (always rendered) ────────────── -->
  <ParticleCanvas
    count={settings.particles?.count              ?? 100}
    speed={settings.particles?.speed              ?? 0.35}
    connectionDistance={settings.particles?.connectionDistance ?? 140}
    mouseRepelRadius={settings.particles?.mouseRepelRadius  ?? 180}
    accentColor={settings.colors?.accent           ?? '#8b5cf6'}
  />
  <CustomCursor />

  <!-- ── Navigation ─────────────────────────────────────── -->
  <Nav navLogo={settings.navLogo ?? 'TG'} />

  {page
    ? (
      <!-- ── Page builder output ─────────────────────────── -->
      <!-- SectionRenderer reads page.sections[] from Sanity  -->
      <!-- and renders each section in order.                  -->
      <!-- Reorder, hide, or add sections from the Studio!     -->
      <SectionRenderer sections={page.sections} settings={settings} />
    )
    : (
      <!-- ── CMS not set up yet fallback ────────────────── -->
      <main style="display:flex;align-items:center;justify-content:center;min-height:100vh;flex-direction:column;gap:16px;position:relative;z-index:2;text-align:center;padding:32px;">
        <p style="font-family:var(--font-display);font-size:22px;color:var(--accent)">
          ✦ CMS Not Connected Yet
        </p>
        <p style="color:var(--text-muted);font-size:14px;max-width:400px;line-height:1.7">
          Run the migration script and create a page with slug "/" in Sanity Studio.
          See <code style="color:var(--accent2)">SETUP.md</code> for instructions.
        </p>
        <a href="/studio" style="color:var(--accent);font-size:13px">Open Studio →</a>
      </main>
    )
  }
</Base>
